# ==============================================================================
# SkillNova Academy — Production Environment Configuration (Template)
# ==============================================================================
# IMPORTANT: This template contains PLACEHOLDERS ONLY. 
# NEVER commit production passwords, connection strings, or secret keys to git.
# Set these in your hosting provider's secure environment settings (e.g. Vercel, Railway).
# ==============================================================================

# Network-Hosted PostgreSQL Database Connection String
# Compatible with Neon, Supabase, Railway, AWS RDS, Render, etc.
# Syntax: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require&schema=public
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require&schema=public"

# Optional Direct Database URL for Prisma migrations if using PgBouncer / Connection Pooler
# DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_DIRECT_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require&schema=public"

# Cryptographic Session Encryption Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-high-entropy-32-byte-secret-key-placeholder"

# Canonical Production Application URLs
NEXTAUTH_URL="https://your-production-domain.edu"
NEXT_PUBLIC_APP_URL="https://your-production-domain.edu"

# Production Environment Flag
NODE_ENV="production"

# Governance & Demo Safety Flags
ENABLE_DEMO_LOGINS="false"
