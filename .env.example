# SkillNova Academy - Environment Configuration
# SQLite Database (default for local development & FYP evaluation)
# To use PostgreSQL, set: postgresql://USER:PASSWORD@HOST:5432/skillnova_db?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth Secret & App URLs
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
