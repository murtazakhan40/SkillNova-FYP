// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model supporting RBAC (Student, Trainer, Admin)
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("STUDENT") // "STUDENT", "TRAINER", "ADMIN"
  avatar       String?
  bio          String?
  headline     String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  coursesTaught   Course[]         @relation("TrainerCourses")
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  quizSubmissions QuizSubmission[]
  reviews         Review[]
  certificates          Certificate[]
  assignmentSubmissions AssignmentSubmission[]
  lessonDiscussions     LessonDiscussion[]
  orders                Order[]

  @@index([role])
  @@index([createdAt])
}

// Category for catalog classification
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // Lucide icon key name
  courses     Course[]
}

// Course Model
model Course {
  id           String       @id @default(uuid())
  title        String
  slug         String       @unique
  subtitle     String?
  description  String
  price        Float        @default(0.0)
  level        String       @default("BEGINNER") // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  language     String       @default("English")
  thumbnail    String?
  published    Boolean      @default(false)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Foreign Keys
  instructorId String
  instructor   User         @relation("TrainerCourses", fields: [instructorId], references: [id], onDelete: Cascade)

  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Relations
  sections     Section[]
  enrollments  Enrollment[]
  quizzes      Quiz[]
  reviews      Review[]
  certificates Certificate[]
  assignments  Assignment[]
  orders       Order[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([published, createdAt])
}

// Curriculum Section
model Section {
  id        String   @id @default(uuid())
  title     String
  order     Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@index([order])
  @@index([courseId, order])
}

// Individual Course Lesson
model Lesson {
  id          String           @id @default(uuid())
  title       String
  duration    String           @default("10 mins")
  videoUrl    String?
  content     String?          // Markdown / Rich text notes
  order       Int              @default(0)
  isFree      Boolean          @default(false)
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  resources   LessonResource[]
  discussions LessonDiscussion[]

  @@index([sectionId])
  @@index([order])
  @@index([sectionId, order])
}

// Student Course Enrollment
model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  progress    Float     @default(0.0) // 0 to 100%
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([progress])
  @@index([userId, updatedAt])
  @@index([userId, progress])
}

// Progress for individual lessons
model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([isCompleted])
  @@index([userId, isCompleted, completedAt])
}

// Assessment Quiz
model Quiz {
  id           String           @id @default(uuid())
  title        String
  passingScore Int              @default(70) // Percentage
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  submissions  QuizSubmission[]

  @@index([courseId])
}

// Multiple Choice Question
model Question {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text          String
  optionsJson   String   // JSON stringified array of options: ["Option A", "Option B", ...]
  correctIndex  Int      // 0-indexed correct option
  explanation   String?

  @@index([quizId])
}

// Student Quiz Attempt Submission
model QuizSubmission {
  id         String   @id @default(uuid())
  quizId     String
  userId     String
  score      Float    // Percentage achieved
  passed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([passed])
  @@index([userId, createdAt])
  @@index([quizId, createdAt])
}

// Course Review & Rating
model Review {
  id        String   @id @default(uuid())
  rating    Int      @default(5) // 1 to 5 stars
  comment   String
  createdAt DateTime @default(now())

  userId   String
  courseId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([rating])
  @@index([courseId, createdAt])
}

// Verified Course Completion Certificate
model Certificate {
  id              String    @id @default(uuid())
  certificateCode String    @unique // e.g. "SN-2026-A8F2-7E91-C4B3"
  issuedAt        DateTime  @default(now())
  grade           Float?    // Verified final assessment score (e.g. 92.5%) - null if course has no quiz
  isRevoked       Boolean   @default(false)
  revokedReason   String?   // Reason for revocation (if any)
  revokedAt       DateTime?

  userId   String
  courseId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([issuedAt])
  @@index([userId, issuedAt])
  @@index([isRevoked])
}

// System & Governance Audit Log
// Stores sanitized operational traces without sensitive credentials, passwords, or secrets.
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g. "USER_ROLE_UPDATED", "COURSE_PUBLISHED", "COURSE_CREATED"
  entity    String   // e.g. "User", "Course"
  entityId  String   // ID of affected entity
  details   String?  // Sanitized JSON string of mutation parameters (NO secrets)
  userId    String?  // Acting user ID (if authenticated)
  ipAddress String?  // Optional client IP identifier
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([action, createdAt])
}

// Lesson Supplementary Materials & Downloads
model LessonResource {
  id        String   @id @default(uuid())
  title     String
  fileName  String
  fileUrl   String   // Protected storage path e.g. "/uploads/resources/xxx.pdf"
  fileSize  Int      // Bytes
  fileType  String   // MIME type
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([lessonId])
}

// Course Practical Project / Coding Assignment
model Assignment {
  id          String                 @id @default(uuid())
  title       String
  description String
  dueDate     DateTime?
  maxScore    Int                    @default(100)
  courseId    String
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([courseId])
  @@index([createdAt])
}

// Student Assignment Submission & Trainer Evaluation
model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  userId       String
  textContent  String?    // Solution notes, text writeup, or git repo URL
  fileUrl      String?    // Attached submission archive / PDF (if uploaded)
  fileName     String?
  fileSize     Int?
  score        Float?     // Grade (0 to 100%)
  feedback     String?    // Trainer review and feedback notes
  status       String     @default("SUBMITTED") // "SUBMITTED", "GRADED", "RESUBMIT_REQUESTED"
  gradedAt     DateTime?
  gradedById   String?    // User ID of evaluator
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
  @@index([status])
}

// Lesson Discussion, Academic Q&A & Peer Inquiry
model LessonDiscussion {
  id        String   @id @default(uuid())
  lessonId  String
  userId    String
  content   String
  isAnswer  Boolean  @default(false)
  reported  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
  @@index([userId])
  @@index([reported])
}

// Order Lifecycle & Payment Tracking
model Order {
  id             String    @id @default(uuid())
  orderNumber    String    @unique // e.g. "ORD-2026-X89J21"
  userId         String
  courseId       String
  amount         Float     // Canonical course fee (PKR) looked up from db
  currency       String    @default("PKR")
  status         String    @default("PENDING") // "PENDING", "COMPLETED", "FAILED", "CANCELLED"
  provider       String    @default("DEMO_SANDBOX") // "DEMO_SANDBOX", "STRIPE", "PAYFAST"
  idempotencyKey String    @unique // Client session checkout idempotency key
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@index([userId, status])
  @@index([courseId])
  @@index([createdAt])
}

// Payment Ledger (PCI-DSS Compliant: NEVER Store PAN or CVV)
model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  providerTxnId String   @unique // External transaction reference from gateway/webhook
  amount        Float
  currency      String
  status        String   // "SUCCESS", "FAILED"
  paymentMethod String   // "DEMO_SIMULATOR", "CARD", "WALLET"
  metadata      String?  // Sanitized JSON (Zero secrets/PAN)
  processedAt   DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerTxnId])
  @@index([status])
}
